# Values-free environment contract for running the lgty-action binary directly.
# GitHub Actions users configure the equivalent reviewed inputs in action.yml;
# LGTY_DB_DSN remains a customer-owned CI secret and is never stored by LGTY.
#
# Shared by both subcommands (`lgty-action metadata` / `lgty-action renders`):
LGTY_BACKEND_URL=
LGTY_DRY_RUN=

# metadata subcommand:
LGTY_DB_DSN=
LGTY_DB_KIND=
LGTY_OIDC_AUDIENCE=
LGTY_REPO=
LGTY_WORKSPACE=

# renders subcommand (LGT-404):
LGTY_RENDERS_DIR=
LGTY_COMMIT_SHA=
LGTY_RENDERS_OIDC_AUDIENCE=
